node_modules/
.env
.env.local
*.log
.DS_Store
/tmp/
# NOT dist/. The built site is committed on purpose — see server.test.js, "the built site is
# committed": the README promises `npm start` with nothing to install and nothing to build, and a
# judge who clones this at 1am should get the site rather than a blank page. It was in this list
# anyway, so the check asserting the opposite passed on every machine that had run a build and
# failed only on a fresh clone, which is the only place it mattered.

# The built index. Large, machine-generated, and rebuildable with `npm run index:build`.
# A published index is a deliberate artefact — see PLAN.md — not something that rides along
# in every commit.
index/data/

local/
.vercel

# web/ is the website's own package. `stakeout` still installs nothing.
web/node_modules/

# What deploy/nebius/launch.sh created (ids only, no secrets) — this machine's, not the repo's.
deploy/nebius/.launch-state

# Ephemeral container work dirs for the malware proof.
proof/.work/

# npm-report drafts (name real packages before review) — working files, not history.
proof/reports/
