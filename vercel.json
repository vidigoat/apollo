{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix web ci && npm --prefix web run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "{public,judge/verdicts}/**"
    },
    "api/[...path].js": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "{public,judge/verdicts}/**"
    }
  }
}
